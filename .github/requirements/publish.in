# The two jobs that hold the PyPI token build and upload with these: publish-pypi.yml and the publish-dev
# job of ci-dev.yml. tomlkit is the version bump of publish-pypi.yml. publish.txt is generated from this file:
# uv pip compile .github/requirements/publish.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --only-binary :all: --exclude-newer <7 days ago> -o .github/requirements/publish.txt
# (--python-version is the one both jobs set up. --exclude-newer keeps the 7-day wait Dependabot uses:
# nothing uploaded in the last week.)
build
twine
tomlkit
